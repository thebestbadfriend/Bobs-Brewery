{
    "name": "window_add_contacts",
    "type": "Toplevel",
    "library": "tkinter",
    "properties": {
        "title": "Add Contacts",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [
            true,
            true
        ]
    },
    "children": [
        {
            "name": "lbf_contact_name",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Contact Name",
                "width": 500,
                "height": 500
            },
            "children": [
                {
                    "name": "tc_contact_name",
                    "library": "tkinter.ttk",
                    "type": "Notebook",
                    "properties": {
                        "height": 200,
                        "width": 400
                    },
                    "children": [
                        {
                            "name": "tab_company_name",
                            "library": "tkinter",
                            "type": "Frame",
                            "title": "Company",
                            "children": [
                                {
                                    "name": "lbl_company_name",
                                    "library": "tkinter",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Company Name"
                                    }
                                },
                                {
                                    "name": "txt_company_name",
                                    "library": "tkinter",
                                    "type": "Entry"
                                },
                                {
                                    "name": "btn_add_company",
                                    "library": "tkinter",
                                    "type": "Button",
                                    "properties": {
                                        "text": "Add Company",
                                        "command": {
                                            "path": "modules.contact_management.event_handlers",
                                            "function": "btn_add_company_clicked",
                                            "kwargs": {
                                                "window": "@@window"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "tab_person_name",
                            "library": "tkinter",
                            "type": "Frame",
                            "title": "Person",
                            "children": [
                                {
                                    "name": "lbl_person_first_name",
                                    "library": "tkinter",
                                    "type": "Label",
                                    "properties": {
                                        "text": "First Name"
                                    }
                                },
                                {
                                    "name": "txt_person_first_name",
                                    "library": "tkinter",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_last_name",
                                    "library": "tkinter",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Last Name"
                                    }
                                },
                                {
                                    "name": "txt_person_last_name",
                                    "library": "tkinter",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_suffix",
                                    "library": "tkinter",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Suffix"
                                    }
                                },
                                {
                                    "name": "txt_person_suffix",
                                    "library": "tkinter",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_nickname",
                                    "library": "tkinter",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Nickname"
                                    }
                                },
                                {
                                    "name": "txt_person_nickname",
                                    "library": "tkinter",
                                    "type": "Entry"
                                },
                                {
                                    "name": "btn_add_person",
                                    "library": "tkinter",
                                    "type": "Button",
                                    "properties": {
                                        "text": "Add Person",
                                        "command": {
                                            "path": "modules.contact_management.event_handlers",
                                            "function": "btn_add_person_clicked",
                                            "kwargs": {
                                                "window": "@@window"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "lbl_phone_number",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Phone Number"
            },
            "children": [

            ]
        },
        {
            "name": "txt_phone_number",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_email_address",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Email Address"
            }
        },
        {
            "name": "txt_email_address",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_street_address",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Street Address"
            }
        },
        {
            "name": "txt_street_address",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_po_box",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "P.O. Box"
            }
        },
        {
            "name": "txt_po_box",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_city",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "City"
            }
        },
        {
            "name": "txt_city",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_state",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "State"
            }
        },
        {
            "name": "txt_state",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "lbl_zip_code",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Zip Code"
            }
        },
        {
            "name": "txt_zip_code",
            "library": "tkinter",
            "type": "Entry"
        }
    ]

}