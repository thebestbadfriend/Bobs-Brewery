{
    "type": "Toplevel",
    "library": "tk",
    "properties": {
        "title": "Add Contacts",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "500x300",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "lbf_contact_name",
            "library": "ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Contact Name",
                "width": 300,
                "height": 300
            },
            "pack_properties": {
                "fill": "both",
                "expand": "True"
            },
            "children": [
                {
                    "name": "tc_contact_name",
                    "library": "ttk",
                    "type": "Notebook",
                    "properties": {
                        "height": 200,
                        "width": 400
                    },
                    "children": [
                        {
                            "name": "tab_company_name",
                            "library": "tk",
                            "type": "Frame",
                            "title": "Company",
                            "children": [
                                {
                                    "name": "lbl_company_name",
                                    "library": "tk",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Company Name"
                                    }
                                },
                                {
                                    "name": "txt_company_name",
                                    "library": "tk",
                                    "type": "Entry"
                                },
                                {
                                    "name": "btn_add_company",
                                    "library": "tk",
                                    "type": "Button",
                                    "properties": {
                                        "text": "Add Company",
                                        "command": "btn_commands.open_favorite_programs"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "tab_person_name",
                            "library": "tk",
                            "type": "Frame",
                            "title": "Person",
                            "children": [
                                {
                                    "name": "lbl_person_first_name",
                                    "library": "tk",
                                    "type": "Label",
                                    "properties": {
                                        "text": "First Name"
                                    }
                                },
                                {
                                    "name": "txt_person_first_name",
                                    "library": "tk",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_last_name",
                                    "library": "tk",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Last Name"
                                    }
                                },
                                {
                                    "name": "txt_person_last_name",
                                    "library": "tk",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_suffix",
                                    "library": "tk",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Suffix"
                                    }
                                },
                                {
                                    "name": "txt_person_suffix",
                                    "library": "tk",
                                    "type": "Entry"
                                },
                                {
                                    "name": "lbl_person_nickname",
                                    "library": "tk",
                                    "type": "Label",
                                    "properties": {
                                        "text": "Nickname"
                                    }
                                },
                                {
                                    "name": "txt_person_nickname",
                                    "library": "tk",
                                    "type": "Entry"
                                },
                                {
                                    "name": "btn_add_person",
                                    "library": "tk",
                                    "type": "Button",
                                    "properties": {
                                        "text": "Add Person",
                                        "command": "btn_commands.open_favorite_programs"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}