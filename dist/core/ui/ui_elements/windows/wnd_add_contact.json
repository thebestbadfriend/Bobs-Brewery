{
    "name": "window_add_company",
    "type": "Toplevel",
    "library": "tkinter",
    "properties": {
        "title": "Add Company",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [
            true,
            true
        ]
    },
    "children": [
        {
            "name": "tc_add_contact",
            "library": "tkinter.ttk",
            "type": "Notebook",
            "properties": {
                "height": 300,
                "width": 500
            },
            "children": [
                {
                    "name": "tab_add_company",
                    "library": "tkinter",
                    "type": "Frame",
                    "title": "Add Company",
                    "children": [
                        {
                            "name": "lbl_company_name",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Company Name"
                            }
                        },
                        {
                            "name": "txt_company_name",
                            "library": "tkinter",
                            "type": "Entry"
                        },
                        {
                            "name": "btn_add_company",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Add Company",
                                "command": {
                                    "path": "modules.contact_management.event_handlers",
                                    "function": "btn_submit_add_company_clicked",
                                    "kwargs": {
                                        "window": "@obj@window"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "tab_add_person",
                    "library": "tkinter",
                    "type": "Frame",
                    "title": "Add Person",
                    "children": [
                        {
                            "name": "lbl_person_first_name",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "First Name"
                            }
                        },
                        {
                            "name": "txt_person_first_name",
                            "library": "tkinter",
                            "type": "Entry"
                        },
                        {
                            "name": "lbl_person_last_name",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Last Name"
                            }
                        },
                        {
                            "name": "txt_person_last_name",
                            "library": "tkinter",
                            "type": "Entry"
                        },
                        {
                            "name": "lbl_person_suffix",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Suffix"
                            }
                        },
                        {
                            "name": "txt_person_suffix",
                            "library": "tkinter",
                            "type": "Entry"
                        },
                        {
                            "name": "lbl_person_nickname",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Nickname"
                            }
                        },
                        {
                            "name": "txt_person_nickname",
                            "library": "tkinter",
                            "type": "Entry"
                        },
                        {
                            "name": "btn_submit_add_person",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Add Person",
                                "command": {
                                    "path": "modules.contact_management.event_handlers",
                                    "function": "btn_submit_add_person_clicked",
                                    "kwargs": {
                                        "window": "@obj@window"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}