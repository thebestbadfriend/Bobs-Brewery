{
    "name": "window_main",
    "type": "Tk",
    "library": "tkinter",
    "properties": {
        "title": "Bob's Brewery",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "tc_main",
            "library": "tkinter.ttk",
            "type": "Notebook",
            "properties": {
                "height": 500,
                "width": 700
            },
            "children": [
                {
                    "name": "tab_main",
                    "library": "tkinter",
                    "type": "Frame",
                    "title": "Main Tab",
                    "children": [
                        {
                            "name": "btn_fix_server_access",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Fix Server Access",
                                "command": {
                                    "path": "core.ui.btn_commands",
                                    "function": "fix_server_access"
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "tab_favorite_programs",
                    "library": "tkinter",
                    "type": "Frame",
                    "title": "Favorite Programs",
                    "children": [
                        {
                            "name": "btn_open_favorite_programs",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Open Favorite Programs",
                                "command": {
                                    "path": "core.ui.btn_commands",
                                    "function": "open_favorite_programs"
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "tab_contacts",
                    "library": "tkinter",
                    "type": "Frame",
                    "title": "Contacts",
                    "children":[
                        {
                            "name": "btn_add_contacts",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Add Contact(s)",
                                "command": {
                                    "path": "modules.contact_management.event_handlers",
                                    "function": "btn_add_contacts_clicked",
                                    "kwargs": {
                                        "window": "@@window"
                                    }
                                }
                            }
                        },
                        {
                            "name": "lbl_search_companies",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Search by company name"
                            }
                        },
                        {
                            "name": "txt_search_companies",
                            "library": "tkinter.ttk",
                            "type": "Entry",
                            "binds": {
                                "<KeyRelease>": {
                                    "module": "modules.contact_management",
                                    "class": "ContactsTreeviewPopulator",
                                    "function": "filter_contacts_treeview",
                                    "args": {
                                        "filter_by": "companies"
                                    }
                                }
                            }
                        },
                        {
                            "name": "lbl_search_people",
                            "library": "tkinter",
                            "type": "Label",
                            "properties": {
                                "text": "Search by person name"
                            }
                        },
                        {
                            "name": "txt_search_people",
                            "library": "tkinter.ttk",
                            "type": "Entry",
                            "binds": {
                                "<KeyRelease>": {
                                    "module": "modules.contact_management",
                                    "class": "ContactsTreeviewPopulator",
                                    "function": "filter_contacts_treeview",
                                    "args": {
                                        "filter_by": "people"
                                    }
                                }
                            }
                        },
                        {
                            "name": "tv_contacts",
                            "library": "tkinter.ttk",
                            "type": "Treeview",
                            "populate_function": {
                                "module": "modules.contact_management",
                                "class": "ContactsTreeviewPopulator",
                                "function_name": "populate_contacts_treeview"
                            },
                            "children": [
                                {
                                    "name": "ctv_vert_scroll",
                                    "library": "tkinter.ttk",
                                    "type": "Scrollbar",
                                    "properties": {
                                        "orient": "vertical",
                                        "command": {
                                            "path": "tv_contacts",
                                            "function": "yview"
                                        }
                                    },
                                    "pack_properties": {
                                        "side": "RIGHT",
                                        "fill": "Y"
                                    }
                                }
                            ],
                            "binds": {
                                "<<TreeviewOpen>>": {
                                    "module": "modules.contact_management",
                                    "class": "ContactsTreeviewPopulator",
                                    "function": "load_details_for_contact",
                                    "args": {

                                    }
                                }
                            },
                            "pack_properties": {
                                "fill": "BOTH",
                                "expand": 1
                            }
                        },
                        {
                            "name": "btn_delete_selected_contact",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Delete Selected Contact",
                                "command": {
                                    "path": "modules.contact_management.event_handlers",
                                    "function": "btn_add_contacts_clicked",
                                    "kwargs": {
                                        "window": "@@window"
                                    }
                                }
                            }
                        },
                        {
                            "name": "btn_update_selected_contact",
                            "library": "tkinter",
                            "type": "Button",
                            "properties": {
                                "text": "Update Selected Contact",
                                "command": {
                                    "path": "modules.contact_management.event_handlers",
                                    "function": "btn_add_contacts_clicked",
                                    "kwargs": {
                                        "window": "@@window"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "btn_exit",
            "library": "tkinter",
            "type": "Button",
            "properties": {
                "text": "Exit",
                "command": {
                    "path": "core.ui.btn_commands",
                    "function": "on_btn_exit_click"
                }
            }
        }
    ]
}