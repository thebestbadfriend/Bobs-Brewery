{
    "type": "Tk",
    "library": "tk",
    "properties": {
        "title": "Bob's Brewery",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "tc_main",
            "library": "ttk",
            "type": "Notebook",
            "properties": {
                "height": 500,
                "width": 700
            },
            "children": [
                {
                    "name": "tab_main",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Main Tab",
                    "children": [
                        {
                            "name": "btn_fix_server_access",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Fix Server Access",
                                "command": "btn_commands.fix_server_access"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_favorite_programs",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Favorite Programs",
                    "children": [
                        {
                            "name": "btn_open_favorite_programs",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Open Favorite Programs",
                                "command": "btn_commands.open_favorite_programs"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_contacts",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Contacts",
                    "children":[
                        {
                            "name": "btn_add_contacts",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Add Contact(s)",
                                "command": "btn_commands.open_favorite_programs"
                            }
                        },
                        {
                            "name": "lbl_search_companies",
                            "library": "tk",
                            "type": "Label",
                            "properties": {
                                "text": "Search by company name"
                            }
                        },
                        {
                            "name": "txt_search_companies",
                            "library": "ttk",
                            "type": "Entry",
                            "binds": {
                                "<KeyRelease>": {
                                    "module": "ContactsTreeviewPopulator",
                                    "function": "filter_contacts_treeview",
                                    "args": {
                                        "filter_by": "companies"
                                    }
                                }
                            }
                        },
                        {
                            "name": "lbl_search_people",
                            "library": "tk",
                            "type": "Label",
                            "properties": {
                                "text": "Search by person name"
                            }
                        },
                        {
                            "name": "txt_search_people",
                            "library": "ttk",
                            "type": "Entry",
                            "binds": {
                                "<KeyRelease>": {
                                    "module": "ContactsTreeviewPopulator",
                                    "function": "filter_contacts_treeview",
                                    "args": {
                                        "filter_by": "people"
                                    }
                                }
                            }
                        },
                        {
                            "name": "tv_contacts",
                            "library": "ttk",
                            "type": "Treeview",
                            "populate_function": {
                                "module": "ContactsTreeviewPopulator",
                                "function_name": "populate_contacts_treeview"
                            },
                            "binds": {
                                "<<TreeviewOpen>>": {
                                    "module": "ContactsTreeviewPopulator",
                                    "function": "load_details_for_contact",
                                    "args": {

                                    }
                                }
                            },
                            "pack_properties": {
                                "fill": "BOTH",
                                "expand": 1
                            }
                        },
                        {
                            "name": "ctv_vert_scroll",
                            "library": "ttk",
                            "type": "Scrollbar",
                            "properties": {
                                "orient": "vertical",
                                "command": "tv_contacts.yview"
                            },
                            "pack_properties": {
                                "side": "RIGHT",
                                "fill": "Y"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "btn_exit",
            "library": "tk",
            "type": "Button",
            "properties": {
                "text": "Exit",
                "command": "btn_commands.on_btn_exit_click"
            }
        }
    ]
}