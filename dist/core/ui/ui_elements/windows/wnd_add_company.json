{
    "name": "window_add_company",
    "type": "Toplevel",
    "library": "tkinter",
    "properties": {
        "title": "Add Company",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [
            true,
            true
        ]
    },
    "children": [
        {
            "name": "lbl_company_name",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Company Name"
            }
        },
        {
            "name": "txt_company_name",
            "library": "tkinter",
            "type": "Entry"
        },
        {
            "name": "btn_add_company",
            "library": "tkinter",
            "type": "Button",
            "properties": {
                "text": "Add Company",
                "command": {
                    "path": "modules.contact_management.event_handlers",
                    "function": "btn_add_company_clicked",
                    "kwargs": {
                        "window": "@obj@window"
                    }
                }
            }
        }
    ]
}