{
    "name": "window_update_contact",
    "type": "Toplevel",
    "library": "tkinter",
    "properties": {
        "title": "Update Contact",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [
            true,
            true
        ]
    },
    "children": [
        {
            "name": "lbl_contact",
            "library": "tkinter",
            "type": "Label",
            "properties": {
                "text": "Something like 'Contact: {contact_name}' but not quite sure how to get there. Tired at the moment"
            }
        },
        {
            "name": "lbf_phone_numbers",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Phone Numbers"
            },
            "children": [
                "list (probably treeview, as I don't think there's any such thing as a listview) of existing phone numbers",
                "btn_delete_phone_number to delete selected phone number in list",
                "lbl_new_phone_number",
                "txt_new_phone_number",
                "btn_add_phone_number to add the phone number in txt_new_phone_number to the list",
                "btn_update_phone_number to change the selected phone number in the list to the number in txt_new_phone_number"
            ]
        },
        {
            "name": "lbf_fax_numbers",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Fax Numbers"
            },
            "children": [

            ]
        },
        {
            "name": "lbf_email_addresses",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Email Addresses"
            },
            "children": [

            ]
        },
        {
            "name": "lbf_addresses",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Addresses"
            },
            "children": [

            ]
        },
        {
            "name": "lbf_websites",
            "library": "tkinter.ttk",
            "type": "LabelFrame",
            "properties": {
                "text": "Websites"
            },
            "children": [

            ]
        }
    ]
}