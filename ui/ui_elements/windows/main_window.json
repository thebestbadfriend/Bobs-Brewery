{
    "type": "Tk",
    "library": "tk",
    "properties": {
        "title": "Bob's Brewery",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "tc_main",
            "library": "ttk",
            "type": "Notebook",
            "properties": {
                "height": 500,
                "width": 700
            },
            "children": [
                {
                    "name": "tab_main",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Main Tab",
                    "children": [
                        {
                            "name": "btn_fix_server_access",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Fix Server Access",
                                "command": "btn_commands.fix_server_access"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_favorite_programs",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Favorite Programs",
                    "children": [
                        {
                            "name": "btn_open_favorite_programs",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Open Favorite Programs",
                                "command": "btn_commands.open_favorite_programs"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_contacts",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Contacts",
                    "children":[
                        {
                            "name": "tv_contacts",
                            "library": "ttk",
                            "type": "Treeview",
                            "populate_function": "tv_populators.populate_contacts_treeview",
                            "properties": {
                            },
                            "pack_properties": {
                                "fill": "BOTH",
                                "expand": 1
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "btn_exit",
            "library": "tk",
            "type": "Button",
            "properties": {
                "text": "Exit",
                "command": "btn_commands.on_btn_exit_click"
            }
        }
    ]
}