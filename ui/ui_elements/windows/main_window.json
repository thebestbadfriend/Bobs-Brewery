{
    "type": "Tk",
    "library": "tk",
    "properties": {
        "title": "Bob's Brewery",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "tc_main",
            "library": "ttk",
            "type": "Notebook",
            "children": [
                {
                    "name": "tab_main",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Main Tab",
                    "children": [
                        {
                            "name": "btn_main",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Main Button"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_favorite_apps",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Favorite Apps"
                },
                {
                    "name": "tab_contacts",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Contacts"
                }
            ]
        },
        {
            "name": "btn_exit",
            "library": "tk",
            "type": "Button",
            "properties": {
                "text": "Exit",
                "command": "on_btn_exit_click"
            }
        }
    ]
}