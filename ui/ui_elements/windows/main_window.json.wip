{
    "type": "Tk",
    "library": "tk",
    "properties": {
        "title": "Bob's Brewery",
        "min_width": 300,
        "min_height": 300,
        "max_width": 3000,
        "max_height": 3000,
        "xpos": 200,
        "ypos": 100,
        "geometry_string": "800x600",
        "resizable": [true, true]
    },
    "children": [
        {
            "name": "tc_main",
            "library": "ttk",
            "type": "Notebook",
            "properties": {
                "height": 500,
                "width": 700
            },
            "children": [
                {
                    "name": "tab_main",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Main Tab",
                    "children": [
                        {
                            "name": "btn_fix_server_access",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Fix Server Access",
                                "command": "btn_commands.fix_server_access"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_favorite_programs",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Favorite Programs",
                    "children": [
                        {
                            "name": "btn_open_favorite_programs",
                            "library": "tk",
                            "type": "Button",
                            "properties": {
                                "text": "Open Favorite Programs",
                                "command": "btn_commands.open_favorite_programs"
                            }
                        }
                    ]
                },
                {
                    "name": "tab_contacts",
                    "library": "tk",
                    "type": "Frame",
                    "title": "Contacts",
                    "children":[
                        {
                            "name": "tv_contacts",
                            "library": "ttk",
                            "type": "Treeview",
                            "populate_function": {
                                "module": "ContactsTreeviewPopulator",
                                "function_name": "populate_contacts_treeview"
                            },
                            "heading": "Companies",
                            "node_hierarchy": [
                                {
                                    "level_name": "company_names",
                                    "level_query": "select name from companies",
                                    "sub_levels": [
                                        {
                                            "level_name": "company_locations",
                                            "text": "Locations",
                                            "sub_levels": [
                                                {
                                                    "level_name": "location",
                                                    "level_query": "",
                                                    "sub_levels": [
                                                        {
                                                            "level_name": "people",
                                                            "text": "People",
                                                            "sub_levels": [
                                                                {
                                                                    "level_name": "person",
                                                                    "level_query": "",
                                                                    "sub_levels": [
                                                                        {
                                                                            "level_name": "phone_numbers",
                                                                            "text": "Phone Numbers",
                                                                            "sub_levels": [
                                                                                {
                                                                                    "level_name": "phone_number",
                                                                                    "level_query": ""
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "level_name": "email_addresses",
                                                                            "text": "Email Addresses",
                                                                            "sub_levels": [
                                                                                {
                                                                                    "level_name": "email_address",
                                                                                    "level_query": ""
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "level_name": "other_contact_info",
                                                                            "text": "Other Contact Info",
                                                                            "sub_levels": [
                                                                                {
                                                                                    "level_name": "info",
                                                                                    "level_query": ""
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "level_name": "company_people_no_location",
                                            "text": "People (no location)",
                                            "sub_levels": []
                                        },
                                        {
                                            "level_name": "company_other",
                                            "text": "Other Contact Details",
                                            "sub_levels": []
                                        }
                                    ]
                                }
                            ],
                            "pack_properties": {
                                "fill": "BOTH",
                                "expand": 1
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "btn_exit",
            "library": "tk",
            "type": "Button",
            "properties": {
                "text": "Exit",
                "command": "btn_commands.on_btn_exit_click"
            }
        }
    ]
}